flowchart LR
    subgraph WRITE["① What gets written"]
        direction TB
        TS["<b>TypeScript 5.7</b>"]
        NX["<b>Next.js 15</b><br/>App Router · React 18.3"]
        TW["<b>Tailwind 3.4</b><br/>+ shadcn/ui"]
        SQL["<b>SQL</b><br/>migrations · RLS policies"]
    end

    subgraph BUILD["② What it becomes"]
        direction TB
        EXP["<b>Static export</b><br/>plain HTML, CSS, JS"]
        MIG["<b>Applied migrations</b><br/>every table keyed by masjid"]
    end

    subgraph RUN["③ Where it runs"]
        direction TB
        CDN["<b>GitHub Pages CDN</b><br/>nothing to patch"]
        PG[("<b>Supabase</b><br/>Postgres 17")]
        EDGE["<b>Edge Functions</b><br/>Deno"]
        RN["<b>React Native · Expo</b>"]
    end

    subgraph OUT["④ What it talks to"]
        direction TB
        STR["<b>Stripe</b><br/>the masjid's own account<br/>0% to us"]
        OS["<b>OneSignal</b><br/>push, per masjid"]
    end

    TS --> NX --> EXP
    TW --> EXP
    SQL --> MIG
    EXP --> CDN
    MIG --> PG
    PG --- EDGE
    RN --> PG
    EDGE --> OS
    STR -.->|"webhook"| EDGE

    classDef write fill:#EAE7DD,stroke:#B4AE9D,color:#12201A
    classDef build fill:#2C4C40,stroke:#C0A46A,stroke-width:2px,color:#F3F1EA
    classDef run fill:#0C2A21,stroke:#2C4C40,color:#F3F1EA
    classDef db fill:#2C4C40,stroke:#C0A46A,stroke-width:3px,color:#F3F1EA
    classDef ext fill:#F3F1EA,stroke:#7D5F2D,stroke-width:2px,color:#12201A
    class TS,NX,TW,SQL write
    class EXP,MIG build
    class CDN,EDGE,RN run
    class PG db
    class STR,OS ext
