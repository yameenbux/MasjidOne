{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // supabase/ is Deno, not Next. Its imports are URLs and its globals are
  // Deno's, so Next's typecheck cannot resolve either and fails the build on
  // the Stripe esm.sh import. It has its own tests —
  // node --experimental-strip-types supabase/functions/masjidone-billing/shape.test.ts
  "exclude": ["node_modules", "supabase"]
}
